# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- PDF marker colour (per source template; see scripts/inspect_spans.py) ---
QUESTION_MARKER_RGB=80,148,110
QUESTION_MARKER_TOLERANCE=30

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Comma-separated handles, with or without '@'. Case-insensitive.
# Resolved to immutable numeric IDs on first contact and pinned thereafter.
TELEGRAM_ALLOWED_USERNAMES=alice,bob
# 2000 MB - the local Bot API server's cap (see the telegram-bot-api service in
# docker-compose.yml). Would need to drop to 20971520 (20 MB) if ever run
# against the public api.telegram.org directly instead.
MAX_UPLOAD_BYTES=2097152000

# --- Local Telegram Bot API server (raises Telegram's 20 MB/50 MB public-API
# limits to 2000 MB) ---
# One-time and free, from a personal Telegram account: https://my.telegram.org
# -> "API development tools" -> create an app. Used only by the
# telegram-bot-api sidecar container below, never read by the Python app.
# In production these are set as GitHub secrets and written into the server's
# .env by the deploy workflow (see DEPLOYMENT.md) - fill them in here only for
# local/manual runs.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- Object storage (MinIO) ---
# Host ports for MinIO (container ports are always 9000/9001).
# Change these if something else on your machine already listens there.
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pdf-to-anki
S3_REGION=us-east-1
S3_SECURE=false
